{
  "name": "chenmeng-launcher",
  "productName": "尘梦启动器",
  "version": "0.1.1",
  "private": true,
  "description": "每个世界，一页梦境。A paper and watercolor Minecraft Java launcher.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "ChenMeng",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "pack": "npm run build && electron-builder --win portable --x64",
    "pack:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@xmcl/core": "2.16.3",
    "@xmcl/installer": "6.3.7",
    "@xmcl/unzip": "2.1.2",
    "adm-zip": "^0.5.16",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "21.0.4",
    "playwright": "^1.56.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "studio.chenmeng.launcher",
    "productName": "尘梦启动器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "public/icon.ico",
      "signAndEditExecutable": true
    },
    "artifactName": "ChenMeng-Launcher-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "ChenMeng-Launcher-${version}-portable.exe"
    }
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  }
}
